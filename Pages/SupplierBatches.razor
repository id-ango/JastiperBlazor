@page "/supplier-batches"
@page "/supplier-batches/{Id:int}"
@using JastiperBlazor.Services
@using JastiperBlazor.Models
@inject SupplierBatchService BatchService
@inject OrderService OrderService
@inject NavigationManager Navigation
@inject IDialogService DialogService

<PageTitle>Supplier Batches</PageTitle>

@if (Id == null)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4" Wrap="Wrap.Wrap">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4" Class="font-weight-bold">Supplier Batches</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Kelola batch pesanan ke supplier</MudText>
        </MudStack>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ShowCreateDialog" StartIcon="@Icons.Material.Filled.Add" Class="px-5">
            Buat Batch Baru
        </MudButton>
    </MudStack>

    <MudPaper Elevation="0" Outlined="true" Class="rounded-lg overflow-hidden">
    <MudTable Items="@_batches" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh><MudTableSortLabel T="SupplierBatch" SortBy="b => b.Name">Nama Batch</MudTableSortLabel></MudTh>
            <MudTh Class="d-none d-md-table-cell"><MudTableSortLabel T="SupplierBatch" SortBy="b => b.SupplierCountry">Negara</MudTableSortLabel></MudTh>
            <MudTh Class="d-none d-md-table-cell"><MudTableSortLabel T="SupplierBatch" SortBy="b => b.OrderDateToSupplier">Tanggal Pesan</MudTableSortLabel></MudTh>
            <MudTh Class="d-none d-sm-table-cell"><MudTableSortLabel T="SupplierBatch" SortBy="b => b.Orders.Count">Jumlah Order</MudTableSortLabel></MudTh>
            <MudTh Class="d-none d-lg-table-cell"><MudTableSortLabel T="SupplierBatch" SortBy="b => b.TotalCostToSupplier">Total Cost</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="SupplierBatch" SortBy="b => b.PaymentDateToSupplier.HasValue">Status Bayar</MudTableSortLabel></MudTh>
            <MudTh>Aksi</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Nama Batch">@context.Name</MudTd>
            <MudTd DataLabel="Negara" Class="d-none d-md-table-cell">@context.SupplierCountry</MudTd>
            <MudTd DataLabel="Tanggal Pesan" Class="d-none d-md-table-cell">@context.OrderDateToSupplier.ToString("dd/MM/yyyy")</MudTd>
            <MudTd DataLabel="Jumlah Order" Class="d-none d-sm-table-cell">@context.Orders.Count</MudTd>
            <MudTd DataLabel="Total Cost" Class="d-none d-lg-table-cell">@context.TotalCostToSupplier.ToString("N0")</MudTd>
            <MudTd DataLabel="Status Bayar">
                @if (context.PaymentDateToSupplier.HasValue)
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">Sudah Bayar</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small">Belum</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Aksi">
                <MudTooltip Text="Lihat batch"><MudIconButton Icon="@Icons.Material.Outlined.Visibility" Color="Color.Primary" Size="Size.Small" OnClick="@(() => Navigation.NavigateTo($"/supplier-batches/{context.Id}"))" /></MudTooltip>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 5, 10, 25 }" />
        </PagerContent>
    </MudTable>
    </MudPaper>
}
else
{
    @if (_selectedBatch == null)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        <MudText Typo="Typo.h4" Class="font-weight-bold mb-4">@_selectedBatch.Name</MudText>
        <MudPaper Elevation="0" Outlined="true" Class="rounded-lg pa-4">
        <MudText>Negara: @_selectedBatch.SupplierCountry</MudText>
        <MudText>Tanggal Pesan: @_selectedBatch.OrderDateToSupplier.ToString("dd/MM/yyyy")</MudText>
        @if (_selectedBatch.PaymentDateToSupplier.HasValue)
        {
            <MudText>Sudah bayar ke supplier: @_selectedBatch.PaymentDateToSupplier?.ToString("dd/MM/yyyy") - Total @_selectedBatch.TotalCostToSupplier.ToString("N0")</MudText>
        }
        </MudPaper>

        <MudText Typo="Typo.h6" Class="font-weight-bold mt-6 mb-2">Orders dalam Batch ini</MudText>
        <MudPaper Elevation="0" Outlined="true" Class="rounded-lg overflow-hidden">
        <MudTable Items="@_selectedBatch.Orders" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>Customer</MudTh>
                <MudTh>Total Jual</MudTh>
                <MudTh>Status</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Customer.Name</MudTd>
                <MudTd>@context.TotalSellingPrice.ToString("N0")</MudTd>
                <MudTd>@context.Status</MudTd>
            </RowTemplate>
        </MudTable>
        </MudPaper>

        <div class="mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AssignOrders">Tambahkan Order (yang sudah DP)</MudButton>
            @if (!_selectedBatch.PaymentDateToSupplier.HasValue)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="MarkPaid" Class="ml-2">Tandai Sudah Bayar ke Supplier</MudButton>
            }
        </div>

        <MudButton Variant="Variant.Outlined" OnClick="@(() => Navigation.NavigateTo("/supplier-batches"))" Class="mt-4">Kembali</MudButton>
    }
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private List<SupplierBatch> _batches = new();
    private SupplierBatch? _selectedBatch;

    protected override async Task OnInitializedAsync()
    {
        if (Id == null)
        {
            _batches = await BatchService.GetAllAsync();
        }
        else
        {
            _selectedBatch = await BatchService.GetByIdAsync(Id.Value);
        }
    }

    private async Task ShowCreateDialog()
    {
        var parameters = new DialogParameters();
        var dialog = await DialogService.ShowAsync<CreateBatchDialog>("Buat Batch Baru", parameters);
        var result = await dialog.Result;
        if (!result.Canceled && result.Data is SupplierBatch newBatch)
        {
            await BatchService.CreateAsync(newBatch);
            _batches = await BatchService.GetAllAsync();
            StateHasChanged();
        }
    }

    private async Task AssignOrders()
    {
        if (_selectedBatch == null) return;
        var pending = await OrderService.GetByStatusAsync(OrderStatus.DPReceived);
        var parameters = new DialogParameters { ["Orders"] = pending, ["BatchId"] = _selectedBatch.Id };
        var dialog = await DialogService.ShowAsync<AssignOrdersDialog>("Pilih Order untuk Batch", parameters);
        var result = await dialog.Result;
        if (!result.Canceled && result.Data is List<int> ids && ids.Any())
        {
            await BatchService.AssignOrdersAsync(_selectedBatch.Id, ids);
            _selectedBatch = await BatchService.GetByIdAsync(_selectedBatch.Id);
            StateHasChanged();
        }
    }

    private async Task MarkPaid()
    {
        if (_selectedBatch == null) return;
        var parameters = new DialogParameters { ["BatchId"] = _selectedBatch.Id };
        var dialog = await DialogService.ShowAsync<MarkBatchPaidDialog>("Catat Pembayaran ke Supplier", parameters);
        var result = await dialog.Result;
        if (!result.Canceled && result.Data is (decimal cost, DateTime date))
        {
            await BatchService.MarkPaymentToSupplierAsync(_selectedBatch.Id, cost, date);
            _selectedBatch = await BatchService.GetByIdAsync(_selectedBatch.Id);
            StateHasChanged();
        }
    }
}
