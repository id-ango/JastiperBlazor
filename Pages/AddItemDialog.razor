@using JastiperBlazor.Models
@using JastiperBlazor.Services
@inject ProductService ProductService
@inject SupplierService SupplierService
@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        <MudPaper Elevation="0" Outlined="true" Class="rounded-lg pa-4">
        <MudTextField T="string" Value="_productSearch" ValueChanged="OnProductSearchChanged" Immediate="true"
                      Label="Cari nama produk" Clearable="true" Variant="Variant.Outlined" />
        <MudText Typo="Typo.body2" Class="mt-2">Dipilih: @(string.IsNullOrWhiteSpace(_item.ProductName) ? "-" : _item.ProductName)</MudText>
        @if (_productMatches.Count > 0)
        {
            <MudList T="string" Dense="true" Class="mt-2">
                @foreach (var name in _productMatches)
                {
                    <MudListItem T="string" Text="@name" OnClick="@(() => SelectProduct(name))" />
                }
            </MudList>
        }
        @if (!string.IsNullOrWhiteSpace(_productSearch) && !_productMatches.Any(p => p.Equals(_productSearch, StringComparison.OrdinalIgnoreCase)))
        {
            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="UseNewProduct" Class="mt-1">
                + Produk baru: "@_productSearch"
            </MudButton>
        }

        <MudNumericField @bind-Value="_item.Quantity" Label="Quantity" Min="1" Class="mt-3" Variant="Variant.Outlined" />
        <MudNumericField @bind-Value="_item.UnitSellingPrice" Label="Harga Jual per Unit" Min="0" Class="mt-3" Variant="Variant.Outlined" />

        <MudText Typo="Typo.body2" Class="mt-3">Supplier: @(_selectedSupplier == null ? "-" : _selectedSupplier.Name)</MudText>
        <MudTextField T="string" Value="_supplierSearch" ValueChanged="OnSupplierSearchChanged" Immediate="true"
                      Label="Cari supplier" Clearable="true" Variant="Variant.Outlined" />
        @if (_supplierMatches.Count > 0)
        {
            <MudList T="Supplier" Dense="true" Class="mt-2">
                @foreach (var s in _supplierMatches)
                {
                    <MudListItem T="Supplier" Text="@($"{s.Name} ({s.Country})")" OnClick="@(() => SelectSupplier(s))" />
                }
            </MudList>
        }
        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="CreateNewSupplier" Class="mt-1">
            + Supplier baru
        </MudButton>

        <MudNumericField @bind-Value="_item.SupplierCost" Label="Biaya ke Supplier (opsional)" Class="mt-3" Variant="Variant.Outlined" />
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Batal</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Add">Tambah</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public EventCallback<OrderItem> OnAdd { get; set; }

    private OrderItem _item = new() { Quantity = 1 };
    private string _productSearch = string.Empty;
    private List<string> _productMatches = new();
    private string _supplierSearch = string.Empty;
    private List<Supplier> _supplierMatches = new();
    private Supplier? _selectedSupplier;

    private async Task OnProductSearchChanged(string value)
    {
        _productSearch = value;
        _productMatches = string.IsNullOrWhiteSpace(value)
            ? new()
            : await ProductService.SearchProductNamesAsync(value);
    }

    private void SelectProduct(string name)
    {
        _item.ProductName = name;
        _productSearch = string.Empty;
        _productMatches = new();
    }

    private void UseNewProduct()
    {
        _item.ProductName = _productSearch.Trim();
        _productSearch = string.Empty;
        _productMatches = new();
    }

    private async Task OnSupplierSearchChanged(string value)
    {
        _supplierSearch = value;
        _supplierMatches = string.IsNullOrWhiteSpace(value)
            ? new()
            : await SupplierService.SearchAsync(value);
    }

    private void SelectSupplier(Supplier supplier)
    {
        _selectedSupplier = supplier;
        _item.SupplierId = supplier.Id;
        _item.SupplierCountry = supplier.Country;
        _supplierSearch = string.Empty;
        _supplierMatches = new();
    }

    private async Task CreateNewSupplier()
    {
        var parameters = new DialogParameters { ["Name"] = _supplierSearch.Trim() };
        var dialog = await DialogService.ShowAsync<QuickSupplierDialog>("Supplier Baru", parameters);
        var result = await dialog.Result;
        if (!result.Canceled && result.Data is Supplier newSupplier)
        {
            SelectSupplier(newSupplier);
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Add()
    {
        if (string.IsNullOrWhiteSpace(_item.ProductName)) return;
        _item.Supplier = _selectedSupplier;
        await OnAdd.InvokeAsync(_item);
        MudDialog.Close(DialogResult.Ok(_item));
    }
}
