@page "/items"
@using JastiperBlazor.Services
@inject ProductService ProductService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Daftar Item</PageTitle>

<MudText Typo="Typo.h4" Class="font-weight-bold mb-4">Daftar Item</MudText>
<MudText Typo="Typo.body2" Class="mb-4">Nama barang yang pernah diinput. Klik edit untuk memperbaiki nama yang salah (akan mengubah semua order yang memakai nama tersebut).</MudText>

<MudTextField @bind-Value="_search" Label="Cari nama item" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Class="mb-4" Style="max-width:320px" Variant="Variant.Outlined" />

<MudPaper Elevation="0" Outlined="true" Class="rounded-lg overflow-hidden">
<MudTable Items="@FilteredItems" Hover="true" Dense="true">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="string" SortBy="s => s">Nama Item</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="string" SortBy="s => _usageCounts.GetValueOrDefault(s, 0)">Jumlah Pemakaian</MudTableSortLabel></MudTh>
        <MudTh>Aksi</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Nama Item">@context</MudTd>
        <MudTd DataLabel="Jumlah Pemakaian">@_usageCounts.GetValueOrDefault(context, 0)</MudTd>
        <MudTd DataLabel="Aksi">
            <MudTooltip Text="Ubah nama"><MudIconButton Icon="@Icons.Material.Outlined.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => Rename(context))" /></MudTooltip>
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
    </PagerContent>
</MudTable>
</MudPaper>

@code {
    private List<string> _allItems = new();
    private Dictionary<string, int> _usageCounts = new();
    private string _search = "";

    private IEnumerable<string> FilteredItems =>
        string.IsNullOrWhiteSpace(_search)
            ? _allItems
            : _allItems.Where(i => i.Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        _allItems = await ProductService.GetAllProductNamesAsync();
        _usageCounts.Clear();
        foreach (var name in _allItems)
        {
            _usageCounts[name] = await ProductService.GetUsageCountAsync(name);
        }
    }

    private async Task Rename(string oldName)
    {
        var parameters = new DialogParameters { ["OldName"] = oldName };
        var dialog = await DialogService.ShowAsync<RenameItemDialog>("Rename Item", parameters);
        var result = await dialog.Result;
        if (!result.Canceled && result.Data is string newName && !string.IsNullOrWhiteSpace(newName))
        {
            await ProductService.RenameProductAsync(oldName, newName.Trim());
            Snackbar.Add($"Nama item diubah menjadi: {newName}", Severity.Success);
            await Load();
        }
    }
}
