@using JastiperBlazor.Models

<MudDialog>
    <DialogContent>
        <MudPaper Elevation="0" Outlined="true" Class="rounded-lg pa-4">
        <MudNumericField @bind-Value="_amount" Label="Jumlah DP" Required="true" Min="0" Variant="Variant.Outlined" />
        <MudDatePicker @bind-Date="_date" Label="Tanggal DP" Class="mt-3" Editable="true" Variant="Variant.Outlined" />
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Batal</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Simpan</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int OrderId { get; set; }

    private decimal _amount;
    private DateTime? _date = DateTime.Today;

    private void Cancel() => MudDialog.Cancel();

    private void Save()
    {
        if (_date.HasValue)
            MudDialog.Close(DialogResult.Ok(new DPRecord(_amount, _date.Value)));
    }
}
