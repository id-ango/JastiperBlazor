@page "/customers"
@using JastiperBlazor.Services
@using JastiperBlazor.Models
@inject CustomerService CustomerService
@inject NavigationManager Navigation

<PageTitle>Customers</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4" Wrap="Wrap.Wrap">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h4" Class="font-weight-bold">Customers</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Daftar pelanggan dan riwayat order</MudText>
    </MudStack>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ShowAddDialog" StartIcon="@Icons.Material.Filled.Add" Class="px-5">
        Tambah Customer
    </MudButton>
</MudStack>

<MudTextField @bind-Value="_searchTerm" Label="Cari nama / WA" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-4" Style="max-width:320px" Immediate="true" Variant="Variant.Outlined" />

<MudPaper Elevation="0" Outlined="true" Class="rounded-lg overflow-hidden mt-4">
<MudTable Items="@_filteredCustomers" Hover="true" Dense="true">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="Customer" SortBy="c => c.Name">Nama</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="Customer" SortBy="c => c.WhatsAppNumber">WhatsApp</MudTableSortLabel></MudTh>
        <MudTh Class="d-none d-sm-table-cell"><MudTableSortLabel T="Customer" SortBy="c => c.Orders.Count">Jumlah Order</MudTableSortLabel></MudTh>
        <MudTh>Aksi</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Nama">@context.Name</MudTd>
        <MudTd DataLabel="WhatsApp">@context.WhatsAppNumber</MudTd>
        <MudTd DataLabel="Jumlah Order" Class="d-none d-sm-table-cell">@context.Orders.Count</MudTd>
        <MudTd DataLabel="Aksi">
            <MudStack Row="true" Spacing="1" Class="flex-nowrap">
                <MudTooltip Text="Lihat customer"><MudIconButton Icon="@Icons.Material.Outlined.Visibility" Color="Color.Primary" Size="Size.Small" OnClick="@(() => ViewCustomer(context.Id))" /></MudTooltip>
                <MudTooltip Text="Ubah customer"><MudIconButton Icon="@Icons.Material.Outlined.Edit" Color="Color.Info" Size="Size.Small" OnClick="@(() => EditCustomer(context))" /></MudTooltip>
            </MudStack>
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager PageSizeOptions="new[] { 5, 10, 25 }" />
    </PagerContent>
</MudTable>
</MudPaper>

@code {
    private List<Customer> _customers = new();
    private List<Customer> _filteredCustomers = new();
    private string _searchTerm = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
    }

    private async Task LoadCustomers()
    {
        _customers = await CustomerService.GetAllAsync();
        FilterCustomers();
    }

    private void FilterCustomers()
    {
        if (string.IsNullOrWhiteSpace(_searchTerm))
            _filteredCustomers = _customers;
        else
            _filteredCustomers = _customers.Where(c =>
                c.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                c.WhatsAppNumber.Contains(_searchTerm)).ToList();
    }

    private void ShowAddDialog()
    {
        // Simple redirect to add page or dialog - for now navigate
        Navigation.NavigateTo("/customers/add");
    }

    private void ViewCustomer(int id)
    {
        Navigation.NavigateTo($"/customers/{id}");
    }

    private void EditCustomer(Customer c)
    {
        Navigation.NavigateTo($"/customers/edit/{c.Id}");
    }
}
