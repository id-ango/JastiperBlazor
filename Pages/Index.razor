@page "/"
@using JastiperBlazor.Services
@using JastiperBlazor.Models
@inject ReportService ReportService
@inject OrderService OrderService

<PageTitle>Dashboard - Jastiper</PageTitle>

<MudText Typo="Typo.h4" Class="font-weight-bold mb-4">Dashboard</MudText>

<MudGrid Spacing="3">
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="0" Outlined="true" Class="pa-4 rounded-lg">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Total Order</MudText>
                    <MudText Typo="Typo.h4" Class="font-weight-bold">@_statusSummary.Values.Sum()</MudText>
                </MudStack>
                <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Rounded="true"><MudIcon Icon="@Icons.Material.Filled.ShoppingCart" /></MudAvatar>
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="0" Outlined="true" Class="pa-4 rounded-lg">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Menunggu DP</MudText>
                    <MudText Typo="Typo.h4" Class="font-weight-bold">@_statusSummary.GetValueOrDefault(OrderStatus.PendingDP)</MudText>
                </MudStack>
                <MudAvatar Color="Color.Warning" Variant="Variant.Outlined" Rounded="true"><MudIcon Icon="@Icons.Material.Filled.HourglassEmpty" /></MudAvatar>
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="0" Outlined="true" Class="pa-4 rounded-lg">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Sudah DP</MudText>
                    <MudText Typo="Typo.h4" Class="font-weight-bold">@_statusSummary.GetValueOrDefault(OrderStatus.DPReceived)</MudText>
                </MudStack>
                <MudAvatar Color="Color.Info" Variant="Variant.Outlined" Rounded="true"><MudIcon Icon="@Icons.Material.Filled.Payments" /></MudAvatar>
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="0" Outlined="true" Class="pa-4 rounded-lg">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Sudah Sampai</MudText>
                    <MudText Typo="Typo.h4" Class="font-weight-bold">@_statusSummary.GetValueOrDefault(OrderStatus.Arrived)</MudText>
                </MudStack>
                <MudAvatar Color="Color.Success" Variant="Variant.Outlined" Rounded="true"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" /></MudAvatar>
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudText Typo="Typo.h5" Class="mt-6 mb-3 font-weight-bold">Order Terbaru</MudText>
<MudPaper Elevation="0" Outlined="true" Class="rounded-lg overflow-hidden">
<MudTable Items="@_recentOrders" Hover="true" Dense="true">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="Order" SortBy="o => o.OrderDate">Tanggal</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="Order" SortBy="o => o.Customer.Name">Customer</MudTableSortLabel></MudTh>
        <MudTh Class="d-none d-sm-table-cell"><MudTableSortLabel T="Order" SortBy="o => o.TotalSellingPrice">Total</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="Order" SortBy="o => o.Status">Status</MudTableSortLabel></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Tanggal">@context.OrderDate.ToString("dd/MM/yyyy")</MudTd>
        <MudTd DataLabel="Customer">@context.Customer.Name</MudTd>
        <MudTd DataLabel="Total" Class="d-none d-sm-table-cell">@context.TotalSellingPrice.ToString("N0")</MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">@context.Status</MudChip>
        </MudTd>
    </RowTemplate>
</MudTable>
</MudPaper>

@code {
    private Dictionary<OrderStatus, int> _statusSummary = new();
    private List<Order> _recentOrders = new();

    protected override async Task OnInitializedAsync()
    {
        _statusSummary = await ReportService.GetOrderStatusSummaryAsync();
        var all = await OrderService.GetAllAsync();
        _recentOrders = all.Take(10).ToList();
    }

    private Color GetStatusColor(OrderStatus status) => status switch
    {
        OrderStatus.PendingDP => Color.Warning,
        OrderStatus.DPReceived => Color.Info,
        OrderStatus.OrderedToSupplier => Color.Primary,
        OrderStatus.Arrived => Color.Success,
        OrderStatus.FullPaymentReceived => Color.Success,
        OrderStatus.Shipped => Color.Success,
        OrderStatus.Cancelled => Color.Error,
        _ => Color.Default
    };
}
