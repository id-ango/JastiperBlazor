@using JastiperBlazor.Models

<MudDialog>
    <DialogContent>
        <MudPaper Elevation="0" Outlined="true" Class="rounded-lg pa-4">
        <MudText>Total Order: @CurrentTotal.ToString("N0")</MudText>
        <MudText>DP Diterima: @DPAmount.ToString("N0")</MudText>
        <MudText>Sisa Pembayaran: @RemainingAmount.ToString("N0")</MudText>
        <MudNumericField @bind-Value="_amount" Label="Jumlah Pembayaran Full" Required="true" Min="0" Class="mt-3" Variant="Variant.Outlined" />
        <MudNumericField @bind-Value="_shipping" Label="Ongkir ke Customer" Min="0" Class="mt-3" Variant="Variant.Outlined" />
        <MudDatePicker @bind-Date="_date" Label="Tanggal Pembayaran" Class="mt-3" Editable="true" Variant="Variant.Outlined" />
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Batal</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Simpan</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int OrderId { get; set; }
    [Parameter] public decimal CurrentTotal { get; set; }
    [Parameter] public decimal DPAmount { get; set; }

    private decimal RemainingAmount => Math.Max(0, CurrentTotal - DPAmount);
    private decimal _amount;
    private decimal _shipping;
    private DateTime? _date = DateTime.Today;

    protected override void OnInitialized()
    {
        _amount = RemainingAmount;
    }

    private void Cancel() => MudDialog.Cancel();

    private void Save()
    {
        if (_date.HasValue)
            MudDialog.Close(DialogResult.Ok(new FullPaymentRecord(_amount, _shipping, _date.Value)));
    }
}
