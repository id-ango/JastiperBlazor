@page "/supplier-items"
@using JastiperBlazor.Models
@using JastiperBlazor.Services
@inject OrderService OrderService
@inject SupplierBatchService BatchService

<PageTitle>Barang Dipesan Supplier</PageTitle>

<div class="d-flex align-center justify-space-between flex-wrap gap-3 mb-4">
    <MudText Typo="Typo.h5" Class="font-weight-bold">Barang Dipesan Supplier</MudText>
    <MudSelect T="string" @bind-Value="_batchFilter" Label="Filter Supplier Batch" Clearable="true" Variant="Variant.Outlined" Dense="true" Style="min-width:260px">
        @foreach (var name in _batchNames)
        {
            <MudSelectItem T="string" Value="@name">@name</MudSelectItem>
        }
    </MudSelect>
</div>

<MudPaper Elevation="0" Outlined="true" Class="rounded-lg overflow-hidden">
<MudTable Items="_filteredItems" Hover="true" Dense="true" Striped="false">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="OrderItem" SortBy="i => i.ArrivedDate.HasValue">Sudah Sampai</MudTableSortLabel></MudTh>
        <MudTh Class="d-none d-md-table-cell"><MudTableSortLabel T="OrderItem" SortBy="i => i.ArrivedDate">Tgl Sampai</MudTableSortLabel></MudTh>
        <MudTh Class="d-none d-sm-table-cell"><MudTableSortLabel T="OrderItem" SortBy="i => i.Order.SupplierBatch?.Name">Supplier Batch</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="OrderItem" SortBy="i => i.ProductName">Produk</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="OrderItem" SortBy="i => i.Order.Customer.Name">Customer</MudTableSortLabel></MudTh>
        <MudTh Class="d-none d-lg-table-cell"><MudTableSortLabel T="OrderItem" SortBy="i => i.OrderId">Order #</MudTableSortLabel></MudTh>
        <MudTh Class="d-none d-sm-table-cell"><MudTableSortLabel T="OrderItem" SortBy="i => i.Quantity">Qty</MudTableSortLabel></MudTh>
        <MudTh Class="d-none d-lg-table-cell"><MudTableSortLabel T="OrderItem" SortBy="i => i.SupplierCountry">Negara</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="OrderItem" SortBy="i => i.Order.Status">Status Order</MudTableSortLabel></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Sudah Sampai">
            <MudCheckBox T="bool" Value="context.ArrivedDate.HasValue" ValueChanged="@(v => ChangeArrivalAsync(context, v ? DateTime.Today : null))" />
        </MudTd>
        <MudTd DataLabel="Tgl Sampai" Class="d-none d-md-table-cell">
            <MudDatePicker Date="context.ArrivedDate" DateChanged="@(d => ChangeArrivalAsync(context, d))" Editable="true" Dense="true" Variant="Variant.Outlined" />
        </MudTd>
        <MudTd DataLabel="Supplier Batch" Class="d-none d-sm-table-cell" Style="min-width:180px">
            <MudSelect T="int?" Value="context.Order.SupplierBatchId" ValueChanged="@(v => ChangeBatchAsync(context, v))" Dense="true" Variant="Variant.Outlined" Placeholder="Pilih batch" Clearable="true">
                @foreach (var b in _batches)
                {
                    <MudSelectItem T="int?" Value="b.Id">@b.Name</MudSelectItem>
                }
            </MudSelect>
        </MudTd>
        <MudTd DataLabel="Produk">@context.ProductName</MudTd>
        <MudTd DataLabel="Customer">@context.Order.Customer.Name</MudTd>
        <MudTd DataLabel="Order #" Class="d-none d-lg-table-cell">#@context.OrderId</MudTd>
        <MudTd DataLabel="Qty" Class="d-none d-sm-table-cell">@context.Quantity</MudTd>
        <MudTd DataLabel="Negara" Class="d-none d-lg-table-cell">@context.SupplierCountry</MudTd>
        <MudTd DataLabel="Status Order">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">@context.Order.Status</MudChip>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Class="pa-6">Belum ada barang yang dipesan ke supplier.</MudText>
    </NoRecordsContent>
</MudTable>
</MudPaper>

@code {
    private List<OrderItem> _items = new();
    private List<SupplierBatch> _batches = new();
    private string? _batchFilter;

    private IEnumerable<string> _batchNames => _items
        .Select(i => i.Order.SupplierBatch?.Name ?? "-")
        .Distinct()
        .OrderBy(n => n);

    private IEnumerable<OrderItem> _filteredItems => string.IsNullOrEmpty(_batchFilter)
        ? _items.OrderBy(i => i.Order.SupplierBatch?.Name ?? "-")
        : _items.Where(i => (i.Order.SupplierBatch?.Name ?? "-") == _batchFilter).OrderBy(i => i.Order.SupplierBatch?.Name ?? "-");


    protected override async Task OnInitializedAsync()
    {
        _items = await OrderService.GetSupplierItemsAsync();
        _batches = await BatchService.GetAllAsync();
    }

    private async Task ChangeArrivalAsync(OrderItem item, DateTime? arrivedDate)
    {
        await OrderService.SetItemArrivalAsync(item.Id, arrivedDate);
        _items = await OrderService.GetSupplierItemsAsync();
    }

    private async Task ChangeBatchAsync(OrderItem item, int? batchId)
    {
        await OrderService.SetSupplierBatchAsync(item.OrderId, batchId);
        _items = await OrderService.GetSupplierItemsAsync();
    }
}
