@using JastiperBlazor.Models

<MudDialog>
    <DialogContent>
        <MudPaper Elevation="0" Outlined="true" Class="rounded-lg pa-4">
        <MudTextField @bind-Value="_batch.Name" Label="Nama Batch" Required="true" Variant="Variant.Outlined" />
        <MudTextField @bind-Value="_batch.SupplierCountry" Label="Negara Supplier" Class="mt-3" Variant="Variant.Outlined" />
        <MudDatePicker @bind-Date="_orderDate" Label="Tanggal Pesan ke Supplier" Class="mt-3" Editable="true" Variant="Variant.Outlined" />
        <MudTextField @bind-Value="_batch.Notes" Label="Catatan" Lines="2" Class="mt-3" Variant="Variant.Outlined" />
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Batal</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Simpan</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    private SupplierBatch _batch = new();
    private DateTime? _orderDate = DateTime.Today;

    private void Cancel() => MudDialog.Cancel();

    private void Save()
    {
        if (!string.IsNullOrWhiteSpace(_batch.Name) && _orderDate.HasValue)
        {
            _batch.OrderDateToSupplier = _orderDate.Value;
            MudDialog.Close(DialogResult.Ok(_batch));
        }
    }
}
