@page "/orders"
@using JastiperBlazor.Services
@using JastiperBlazor.Models
@inject OrderService OrderService
@inject NavigationManager Navigation
@inject IDialogService DialogService

<PageTitle>Orders</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4" Wrap="Wrap.Wrap">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h4" Class="font-weight-bold">Daftar Order</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Kelola order dan status pesanan</MudText>
    </MudStack>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Navigation.NavigateTo("/orders/add"))" StartIcon="@Icons.Material.Filled.Add" Class="px-5">
        Order Baru
    </MudButton>
</MudStack>

<MudSelect T="OrderStatus?" @bind-Value="_filterStatus" Label="Filter Status" Class="mb-4" Style="max-width:320px" Clearable="true" Variant="Variant.Outlined" AdornmentIcon="@Icons.Material.Filled.FilterList">
    @foreach (var status in Enum.GetValues<OrderStatus>())
    {
        <MudSelectItem T="OrderStatus?" Value="@status">@status</MudSelectItem>
    }
</MudSelect>

<MudPaper Elevation="0" Outlined="true" Class="rounded-lg overflow-hidden mt-4">
<MudTable Items="@_filteredOrders" Hover="true" Dense="true">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="Order" SortBy="o => o.Id">ID</MudTableSortLabel></MudTh>
        <MudTh Class="d-none d-md-table-cell"><MudTableSortLabel T="Order" SortBy="o => o.OrderDate">Tanggal</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="Order" SortBy="o => o.Customer.Name">Customer</MudTableSortLabel></MudTh>
        <MudTh Class="d-none d-sm-table-cell"><MudTableSortLabel T="Order" SortBy="o => o.TotalSellingPrice">Total Jual</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="Order" SortBy="o => o.Status">Status</MudTableSortLabel></MudTh>
        <MudTh>Aksi</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="ID">@context.Id</MudTd>
        <MudTd DataLabel="Tanggal" Class="d-none d-md-table-cell">@context.OrderDate.ToString("dd/MM/yyyy")</MudTd>
        <MudTd DataLabel="Customer">@context.Customer.Name</MudTd>
        <MudTd DataLabel="Total Jual" Class="d-none d-sm-table-cell">@context.TotalSellingPrice.ToString("N0")</MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">@context.Status</MudChip>
        </MudTd>
        <MudTd DataLabel="Aksi">
            <MudStack Row="true" Spacing="1" Class="flex-nowrap">
                <MudTooltip Text="Lihat detail"><MudIconButton Icon="@Icons.Material.Outlined.Visibility" Color="Color.Primary" Size="Size.Small" OnClick="@(() => ShowDetail(context.Id))" /></MudTooltip>
                <MudTooltip Text="Ubah order"><MudIconButton Icon="@Icons.Material.Outlined.Edit" Color="Color.Default" Size="Size.Small" OnClick="@(() => Navigation.NavigateTo($"/orders/{context.Id}"))" /></MudTooltip>
            </MudStack>
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager PageSizeOptions="new[] { 5, 10, 25 }" />
    </PagerContent>
</MudTable>
</MudPaper>

@code {
    private List<Order> _orders = new();
    private List<Order> _filteredOrders = new();
    private OrderStatus? _filterStatus;

    protected override async Task OnInitializedAsync()
    {
        _orders = await OrderService.GetAllAsync();
        Filter();
    }

    protected override void OnParametersSet()
    {
        Filter();
    }

    private void Filter()
    {
        _filteredOrders = _filterStatus.HasValue
            ? _orders.Where(o => o.Status == _filterStatus).ToList()
            : _orders;
    }

    private async Task ShowDetail(int orderId)
    {
        var parameters = new DialogParameters { ["OrderId"] = orderId };
        await DialogService.ShowAsync<OrderDetailDialog>("Detail Order", parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
    }

    private Color GetStatusColor(OrderStatus status) => status switch
    {
        OrderStatus.PendingDP => Color.Warning,
        OrderStatus.DPReceived => Color.Info,
        OrderStatus.OrderedToSupplier => Color.Primary,
        OrderStatus.Arrived => Color.Success,
        OrderStatus.Cancelled => Color.Error,
        _ => Color.Default
    };
}
