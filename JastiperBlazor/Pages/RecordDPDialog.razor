@using JastiperBlazor.Models

<MudDialog>
    <DialogContent>
        <MudNumericField @bind-Value="_amount" Label="Jumlah DP" Required="true" Min="0" />
        <MudDatePicker @bind-Date="_date" Label="Tanggal DP" Class="mt-3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Batal</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Simpan</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int OrderId { get; set; }

    private decimal _amount;
    private DateTime? _date = DateTime.Today;

    private void Cancel() => MudDialog.Cancel();

    private void Save()
    {
        if (_date.HasValue)
            MudDialog.Close(DialogResult.Ok(new DPRecord(_amount, _date.Value)));
    }
}
