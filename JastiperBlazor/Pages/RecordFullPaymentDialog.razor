@using JastiperBlazor.Models

<MudDialog>
    <DialogContent>
        <MudText>Total Order: @CurrentTotal.ToString("N0")</MudText>
        <MudNumericField @bind-Value="_amount" Label="Jumlah Pembayaran Full" Required="true" Min="0" Class="mt-3" />
        <MudNumericField @bind-Value="_shipping" Label="Ongkir ke Customer" Min="0" Class="mt-3" />
        <MudDatePicker @bind-Date="_date" Label="Tanggal Pembayaran" Class="mt-3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Batal</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Simpan</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int OrderId { get; set; }
    [Parameter] public decimal CurrentTotal { get; set; }

    private decimal _amount;
    private decimal _shipping;
    private DateTime? _date = DateTime.Today;

    private void Cancel() => MudDialog.Cancel();

    private void Save()
    {
        if (_date.HasValue)
            MudDialog.Close(DialogResult.Ok(new FullPaymentRecord(_amount, _shipping, _date.Value)));
    }
}
