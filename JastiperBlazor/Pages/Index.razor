@page "/"
@using JastiperBlazor.Services
@using JastiperBlazor.Models
@inject ReportService ReportService
@inject OrderService OrderService

<PageTitle>Dashboard - Jastiper</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Dashboard</MudText>

<MudGrid>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 d-flex align-center" Elevation="1" Style="border-left: 4px solid #1976d2;">
            <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Color="Color.Primary" Class="mr-4" Size="Size.Large" />
            <div>
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Total Order</MudText>
                <MudText Typo="Typo.h4">@_statusSummary.Values.Sum()</MudText>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 d-flex align-center" Elevation="1" Style="border-left: 4px solid #ed6c02;">
            <MudIcon Icon="@Icons.Material.Filled.Schedule" Color="Color.Warning" Class="mr-4" Size="Size.Large" />
            <div>
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Menunggu DP</MudText>
                <MudText Typo="Typo.h4">@_statusSummary.GetValueOrDefault(OrderStatus.PendingDP)</MudText>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 d-flex align-center" Elevation="1" Style="border-left: 4px solid #0288d1;">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Info" Class="mr-4" Size="Size.Large" />
            <div>
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Sudah DP</MudText>
                <MudText Typo="Typo.h4">@_statusSummary.GetValueOrDefault(OrderStatus.DPReceived)</MudText>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 d-flex align-center" Elevation="1" Style="border-left: 4px solid #2e7d32;">
            <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Color="Color.Success" Class="mr-4" Size="Size.Large" />
            <div>
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Sudah Sampai</MudText>
                <MudText Typo="Typo.h4">@_statusSummary.GetValueOrDefault(OrderStatus.Arrived)</MudText>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudPaper Class="mt-6 pa-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-4">Order Terbaru</MudText>
    <MudTable Items="@_recentOrders" Hover="true" Dense="true" Elevation="0">
        <HeaderContent>
            <MudTh>Tanggal</MudTh>
            <MudTh>Customer</MudTh>
            <MudTh>Total</MudTh>
            <MudTh>Status</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.OrderDate.ToString("dd/MM/yyyy")</MudTd>
            <MudTd>@context.Customer.Name</MudTd>
            <MudTd>@context.TotalSellingPrice.ToString("N0")</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)" Variant="Variant.Filled">@GetStatusText(context.Status)</MudChip>
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>

@code {
    private Dictionary<OrderStatus, int> _statusSummary = new();
    private List<Order> _recentOrders = new();

    protected override async Task OnInitializedAsync()
    {
        _statusSummary = await ReportService.GetOrderStatusSummaryAsync();
        var all = await OrderService.GetAllAsync();
        _recentOrders = all.Take(10).ToList();
    }

    private Color GetStatusColor(OrderStatus status) => status switch
    {
        OrderStatus.PendingDP => Color.Warning,
        OrderStatus.DPReceived => Color.Info,
        OrderStatus.OrderedToSupplier => Color.Primary,
        OrderStatus.Arrived => Color.Success,
        OrderStatus.FullPaymentReceived => Color.Success,
        OrderStatus.Shipped => Color.Success,
        OrderStatus.Completed => Color.Success,
        OrderStatus.Cancelled => Color.Error,
        _ => Color.Default
    };

    private string GetStatusText(OrderStatus status) => status switch
    {
        OrderStatus.PendingDP => "Menunggu DP",
        OrderStatus.DPReceived => "Sudah DP",
        OrderStatus.OrderedToSupplier => "Dipesan Supplier",
        OrderStatus.Arrived => "Sudah Sampai",
        OrderStatus.AwaitingFullPayment => "Menunggu Full",
        OrderStatus.FullPaymentReceived => "Sudah Lunas",
        OrderStatus.Shipped => "Dikirim",
        OrderStatus.Completed => "Selesai",
        OrderStatus.Cancelled => "Batal",
        _ => status.ToString()
    };
}
