@using JastiperBlazor.Models

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_batch.Name" Label="Nama Batch" Required="true" />
        <MudSelect T="string" @bind-Value="_batch.SupplierCountry" Label="Negara Supplier" Class="mt-3">
            <MudSelectItem T="string" Value="@("Korea")">Korea</MudSelectItem>
            <MudSelectItem T="string" Value="@("China")">China</MudSelectItem>
        </MudSelect>
        <MudDatePicker @bind-Date="_orderDate" Label="Tanggal Pesan ke Supplier" Class="mt-3" />
        <MudTextField @bind-Value="_batch.Notes" Label="Catatan" Lines="2" Class="mt-3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Batal</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Simpan</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;

    private SupplierBatch _batch = new();
    private DateTime? _orderDate = DateTime.Today;

    private void Cancel() => MudDialog.Cancel();

    private void Save()
    {
        if (!string.IsNullOrWhiteSpace(_batch.Name) && _orderDate.HasValue)
        {
            _batch.OrderDateToSupplier = _orderDate.Value;
            MudDialog.Close(DialogResult.Ok(_batch));
        }
    }
}
